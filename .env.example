###############################################################################
# 永霏集团官网 v2 — 环境变量示例
#
# 用法:
#   1. 复制本文件为 .env.local（不入仓）
#   2. 按本地/测试/生产环境填写实际值
#   3. 生产环境建议通过服务器环境变量或 CI/CD secrets 注入
#
# 变量校验: src/lib/env.ts 在启动时使用 Zod 校验，缺失必需变量会直接报错退出。
###############################################################################


# ============================================================================
# 1. 站点基础
# ============================================================================

# 完整站点 URL，包含协议。用于 canonical、og:url、sitemap、邮件链接等。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 默认语言和支持语言。当前固定支持 zh / en / ru。
NEXT_PUBLIC_DEFAULT_LOCALE=zh
NEXT_PUBLIC_LOCALES=zh,en,ru

# 健康检查/发布识别版本号，生产环境可由 CI 注入构建号或 Git SHA。
APP_VERSION=0.0.0-local

# development / production / test
NODE_ENV=development

# Next.js 构建阶段标识，通常由 Next.js 自动注入，本地一般留空。
NEXT_PHASE=

# 应用监听端口。
PORT=3000

# 服务端默认时区。
TZ=Asia/Shanghai

# Next.js 静态生成 worker 数。低内存服务器建议设为 1。
NEXT_BUILD_WORKERS=1


# ============================================================================
# 2. Payload CMS
# ============================================================================

# Payload session/jwt 签名密钥，生产环境必须设置 32+ 字符随机串。
# 生成示例: openssl rand -base64 48
PAYLOAD_SECRET=

# Payload server URL，通常与 NEXT_PUBLIC_SITE_URL 相同。
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

PAYLOAD_CONFIG_PATH=src/payload.config.ts
PAYLOAD_PUBLIC_ADMIN_PATH=/admin
PAYLOAD_ADMIN_LOCALE=zh
PAYLOAD_PUBLIC_API_PATH=/payload-api
PAYLOAD_PUBLIC_GRAPHQL_PATH=/payload-graphql
PAYLOAD_PUBLIC_GRAPHQL_PLAYGROUND_PATH=/payload-graphql-playground

# 默认禁止 Payload 启动时自动 push schema，避免误改非空数据库。
# 只在一次性本地空库/临时库中明确接受 schema 自动同步风险时设为 true。
PAYLOAD_DB_PUSH=false

# 发布内容时默认要求 zh / en / ru 三语齐全；紧急情况下可设为 false，仅记录警告不阻断。
STRICT_I18N_PUBLISH=true

# 如生产需要限定 cookie 域名，可填写 .yourdomain.com；本地留空。
COOKIE_DOMAIN=


# ============================================================================
# 3. PostgreSQL 数据库
# ============================================================================

# 本地 docker 默认示例。生产环境请改为真实数据库连接串。
DATABASE_URI=postgresql://postgres:password@localhost:5432/yourfield_dev

DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_SLOW_QUERY_MS=500


# ============================================================================
# 4. 对象存储 / 媒体上传
# ============================================================================

# S3 变量全空时使用 Payload 本地 disk fallback。
# 以下 5 项全部填写时启用 S3 兼容对象存储；只填写部分会触发启动校验失败。
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 公开访问 URL base。可填写 CDN 域名或 bucket 公开域名。
S3_PUBLIC_URL_BASE=

# 上传大小上限，单位字节。
MEDIA_UPLOAD_IMAGE_MAX_BYTES=10485760
MEDIA_UPLOAD_PDF_MAX_BYTES=20971520
MEDIA_UPLOAD_VIDEO_MAX_BYTES=104857600


# ============================================================================
# 5. Umami 统计
# ============================================================================

UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
UMAMI_API_KEY=
UMAMI_API_URL=


# ============================================================================
# 6. 邮件发送
# ============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=

CONTACT_NOTIFY_TO=hnyf@yourfield.net
SUPPORT_REPLY_TO=hnyf@yourfield.net


# ============================================================================
# 7. 地图 API
# ============================================================================

AMAP_KEY=
AMAP_SECURITY_CODE=
GOOGLE_MAPS_KEY=
YANDEX_MAPS_KEY=


# ============================================================================
# 8. 反垃圾 / CAPTCHA
# ============================================================================

# 生产环境必须设置 Turnstile site key 与 secret。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# 默认不信任 x-forwarded-for / x-real-ip / cf-connecting-ip 等代理头。
# 仅当生产入口代理会覆盖这些请求头时才设为 true。
CONTACT_FORM_TRUST_PROXY_HEADERS=false


# ============================================================================
# 9. 监控告警
# ============================================================================

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
ALERT_WEBHOOK=


# ============================================================================
# 10. CI / 构建 / 内部密钥
# ============================================================================

NEXT_TELEMETRY_DISABLED=1

# 仅在明确需要跳过 env 校验的 CI/临时构建场景中设为 true。
SKIP_ENV_VALIDATION=false

# seed 脚本内部标记，一般不用手动设置。
PAYLOAD_SEED_MODE=false

# 生产环境必填。生成示例: openssl rand -hex 32
CRON_SECRET=
REVALIDATE_SECRET=
PAYLOAD_PREVIEW_SECRET=


# ============================================================================
# 12. 后台超管 seed（本地开发 / staging）
# ============================================================================

SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
