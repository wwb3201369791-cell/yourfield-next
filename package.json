{
  "name": "yourfield-next",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development TZ=Asia/Shanghai PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx src/server.ts",
    "dev:warm": "cross-env NODE_ENV=development TZ=Asia/Shanghai PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/dev-warm.ts",
    "dev:next": "cross-env NODE_ENV=development TZ=Asia/Shanghai next dev",
    "build": "cross-env TZ=Asia/Shanghai PAYLOAD_CONFIG_PATH=src/payload.config.ts next build",
    "start": "cross-env TZ=Asia/Shanghai NODE_ENV=production PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx src/server.ts",
    "start:next": "next start",
    "payload": "cross-env TZ=Asia/Shanghai PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "payload:build": "cross-env NODE_ENV=development pnpm payload generate:importmap && cross-env NODE_ENV=development pnpm payload generate:types",
    "payload:migrate": "cross-env TZ=Asia/Shanghai PAYLOAD_CONFIG_PATH=src/payload.config.ts payload migrate",
    "seed": "cross-env TZ=Asia/Shanghai PAYLOAD_SEED_MODE=true PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/seed/index.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "cross-env NODE_ENV=test vitest run",
    "check:env": "cross-env NODE_ENV=production PAYLOAD_CONFIG_PATH=src/payload.config.ts tsx scripts/check-env.ts",
    "test:e2e": "pnpm test:e2e:dev",
    "test:e2e:dev": "cross-env NODE_ENV=development tsx tests/e2e/critical-paths.ts",
    "test:e2e:production": "cross-env E2E_BASE_URL=http://localhost:3100 tsx tests/e2e/critical-paths.ts",
    "typecheck": "tsc --noEmit",
    "script:check-i18n-coverage": "tsc -p tsconfig.scripts.json && node node_modules/.cache/yourfield-scripts/check-i18n-coverage.js",
    "script:snapshot-mobile": "tsc -p tsconfig.scripts.json && node node_modules/.cache/yourfield-scripts/snapshot-mobile.js",
    "script:db-backup": "tsc -p tsconfig.scripts.json && node node_modules/.cache/yourfield-scripts/scripts/db-backup.js",
    "script:db-restore": "tsc -p tsconfig.scripts.json && node node_modules/.cache/yourfield-scripts/scripts/db-restore.js",
    "script:asset-audit": "tsx scripts/static-asset-audit.ts",
    "script:perf-check": "tsc -p tsconfig.scripts.json && node node_modules/.cache/yourfield-scripts/scripts/performance-check.js",
    "script:prod-baseline": "tsx scripts/production-baseline.ts",
    "script:verify-home-hero": "tsc -p tsconfig.scripts.json && node node_modules/.cache/yourfield-scripts/scripts/verify-home-hero.js",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1057.0",
    "@aws-sdk/lib-storage": "3.1057.0",
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/plugin-cloud-storage": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/storage-s3": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "ajv": "8.18.0",
    "aws-crt": "1.26.2",
    "cross-env": "7.0.3",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "5.2.1",
    "graphql": "16.8.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-intl": "4.13.0",
    "payload": "3.85.0",
    "pinyin-pro": "3.27.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "5.0.6",
    "@types/node": "20.19.41",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "autoprefixer": "10.5.0",
    "commitlint": "^21.0.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "playwright": "1.58.0",
    "postcss": "8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "vitest": "1.6.1",
    "webpack": "^5.107.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.34.5"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
