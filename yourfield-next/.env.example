###############################################################################
# 永霏集团官网 v2 — 环境变量清单
#
# 用法:
#   1. 复制本文件为 .env.local(进 .gitignore,不入仓)
#   2. 填入实际值(标 [NEEDS-INPUT] 的项必须先向用户拿到)
#   3. 生产环境通过 CI/CD secrets 注入,不读 .env 文件
#
# 变量校验:src/lib/env.ts 在启动时用 Zod 校验,缺失必需变量直接报错退出
# 修改本文件:见 升级实施书_v2/附录C-env示例.md
###############################################################################


# ============================================================================
# 1. 站点基础(P0 必填)
# ============================================================================

# 完整生产域名(含协议),用于 canonical / og:url / sitemap / 邮件链接
# 开发环境用 http://localhost:3000
# 生产环境 [NEEDS-INPUT,P5 阶段] 例如 https://www.yourfield.cn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 默认 locale,用户首次访问且 Accept-Language 不匹配时落到此
# 用户已确认:zh(与旧站默认 en 不同)
NEXT_PUBLIC_DEFAULT_LOCALE=zh

# 支持的所有 locale,逗号分隔
# 缺一不可(02 §2.4 明令不做)
NEXT_PUBLIC_LOCALES=zh,en,ru

# Next.js 运行环境
# development / production / test
NODE_ENV=development


# ============================================================================
# 2. Payload CMS(P0 末期 / P2 前必填)
# ============================================================================

# Payload session/jwt 签名密钥,32+ 字符随机串
# 生成命令:openssl rand -base64 48
# [NEEDS-INPUT] codex 不得自填;P0 末期在 .env.local 用上述命令生成
PAYLOAD_SECRET=

# Payload server URL(后台路径会拼这个),通常与 NEXT_PUBLIC_SITE_URL 相同
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Payload config 文件路径(P0 创建后此值不变)
PAYLOAD_CONFIG_PATH=src/payload.config.ts

# Payload admin 路径(默认 /admin)
PAYLOAD_PUBLIC_ADMIN_PATH=/admin


# ============================================================================
# 3. 数据库(P2 前必填)
# ============================================================================

# PostgreSQL 连接 URI
# 本地开发:postgresql://postgres:password@localhost:5432/yourfield_dev
# 生产环境 [NEEDS-INPUT,P5 阶段] 由 RDS 提供
DATABASE_URI=postgresql://postgres:password@localhost:5432/yourfield_dev

# 连接池配置(可选,有默认)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# 慢查询日志阈值(毫秒,可选)
DATABASE_SLOW_QUERY_MS=500


# ============================================================================
# 4. 对象存储(P2 前必填)
# ============================================================================

# S3 兼容协议端点
# 阿里云 OSS:https://oss-cn-hangzhou.aliyuncs.com
# 腾讯云 COS:https://cos.ap-shanghai.myqcloud.com
# MinIO:http://localhost:9000
# [NEEDS-INPUT] 由用户拍板服务商
S3_ENDPOINT=

# Region 名(与上面 endpoint 对应)
S3_REGION=

# Bucket 名,建议命名 yourfield-media-{env}
# [NEEDS-INPUT]
S3_BUCKET=

# Access Key ID
# [NEEDS-INPUT] 不入仓,放 .env.local;生产经 CI secrets 注入
S3_ACCESS_KEY_ID=

# Secret Access Key
# [NEEDS-INPUT] 同上,极敏感
S3_SECRET_ACCESS_KEY=

# 公开访问 URL base(若挂 CDN,填 CDN 域名;否则 S3 endpoint)
# 例如:https://media.yourfield.cn
# 或:https://yourfield-media-prod.oss-cn-hangzhou.aliyuncs.com
S3_PUBLIC_URL_BASE=


# ============================================================================
# 5. 全文搜索 Meilisearch(P3 前必填)
# ============================================================================

# Meilisearch 实例 URL
# 本地 docker:http://localhost:7700
# 生产:同 region 内网 http://meili.internal:7700 或域名
MEILI_HOST=http://localhost:7700

# Meili master key(写权限,仅服务端使用,极敏感)
# 生成:openssl rand -hex 32
# [NEEDS-INPUT] P3 阶段生成
MEILI_MASTER_KEY=

# Meili search-only key(只读,可暴露给前端 SSR 调用)
# 在 master key 启用后,通过 Meili API 创建:
#   curl -X POST $MEILI_HOST/keys -H "Authorization: Bearer $MEILI_MASTER_KEY" \
#     -d '{"description":"search-only","actions":["search"],"indexes":["*"],"expiresAt":null}'
# [NEEDS-INPUT]
MEILI_SEARCH_KEY=

# Index 前缀(多环境共享 Meili 实例时区分,可选)
MEILI_INDEX_PREFIX=yourfield_dev_


# ============================================================================
# 6. 网站统计 Umami(P3 前必填)
# ============================================================================

# Umami 站点 ID(在 Umami 后台 Add Website 后获取)
# [NEEDS-INPUT,P3 阶段]
UMAMI_WEBSITE_ID=

# Umami 脚本完整 URL,前端 <script src> 用
# 通常 https://[your-umami-domain]/script.js
# [NEEDS-INPUT]
UMAMI_SCRIPT_URL=

# Umami REST API key,后台统计看板拉数据用
# [NEEDS-INPUT] 在 Umami 后台 Settings → API Keys 创建
UMAMI_API_KEY=

# Umami API base URL
# 通常 https://[your-umami-domain]/api
UMAMI_API_URL=


# ============================================================================
# 7. 邮件发送(P2 前必填)
# ============================================================================

# SMTP host
# 阿里云邮件推送:smtpdm.aliyun.com
# 腾讯企业邮:smtp.exmail.qq.com
# Resend:smtp.resend.com(端口 587 / 2587)
# Postmark:smtp.postmarkapp.com
# [NEEDS-INPUT]
SMTP_HOST=

# SMTP 端口(587 = STARTTLS / 465 = SSL / 25 = 明文不推荐)
SMTP_PORT=587

# SMTP 用户名
SMTP_USER=

# SMTP 密码 / API key
# [NEEDS-INPUT] 不入仓
SMTP_PASSWORD=

# 是否用 TLS
SMTP_SECURE=false

# 发件人地址(必须为子域以隔离主域,见 07 §R5)
# 例如:"永霏集团 <noreply@mail.yourfield.cn>"
# [NEEDS-INPUT]
SMTP_FROM=

# 表单线索通知收件人(用户已确认)
CONTACT_NOTIFY_TO=hnyf@yourfield.net

# 后台密码重置邮件 reply-to(可选)
SUPPORT_REPLY_TO=hnyf@yourfield.net


# ============================================================================
# 8. 地图 API(P1 末期 / P3 前必填)
# ============================================================================

# 高德 Web 服务 API key,/zh locale 地图用
# 申请:https://lbs.amap.com/dev/
# [NEEDS-INPUT,P1 阶段] 见 07 §R1
AMAP_KEY=

# 高德 Web 服务安全密钥(部分接口需 jscode + 安全密钥)
AMAP_SECURITY_CODE=

# Google Maps Embed API key,/en /ru locale 地图用
# 申请:https://console.cloud.google.com/google/maps-apis
# [NEEDS-INPUT,P1 阶段]
GOOGLE_MAPS_KEY=

# Yandex Maps API key(可选,/ru locale 兜底)
# [NEEDS-INPUT,待用户决定是否启用]
YANDEX_MAPS_KEY=


# ============================================================================
# 9. 反垃圾 / CAPTCHA(P4 前必填)
# ============================================================================

# 选 Cloudflare Turnstile(默认推荐,无需 Google 域名,免费)
# 申请:https://dash.cloudflare.com/?to=/:account/turnstile
# [NEEDS-INPUT,P4 阶段]
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# 或选 reCAPTCHA v3(备选,国内访问 Google 域名风险)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET=


# ============================================================================
# 10. 监控告警(P4 / P5)
# ============================================================================

# Sentry DSN(自托管 Sentry / Glitchtip)
# [NEEDS-INPUT,P4 阶段]
SENTRY_DSN=

# Sentry org / project(发布跟踪用,可选)
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry release token(CI 上传 sourcemap 用)
SENTRY_AUTH_TOKEN=

# 告警 webhook URL
# 钉钉:https://oapi.dingtalk.com/robot/send?access_token=xxx
# 企业微信:https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# Slack:https://hooks.slack.com/services/xxx/xxx
# [NEEDS-INPUT,P5 阶段]
ALERT_WEBHOOK=


# ============================================================================
# 11. CI / 构建 / 内部
# ============================================================================

# 禁用 Next.js 遥测(P0 决定)
NEXT_TELEMETRY_DISABLED=1

# 跳过 env 校验(仅 CI build 时设 true,避免没填密钥也能 build artifact)
SKIP_ENV_VALIDATION=false

# Cron / 定时任务密钥(P3 后,用于 Vercel Cron / 自建 cron 调用 webhook)
CRON_SECRET=

# revalidate webhook 签名 secret(Payload 调 /api/revalidate 时验证)
# 生成:openssl rand -hex 32
# [NEEDS-INPUT,P2 阶段]
REVALIDATE_SECRET=

# preview 模式 secret(防止未授权访问草稿)
# 生成:openssl rand -hex 32
# [NEEDS-INPUT,P2 阶段]
PAYLOAD_PREVIEW_SECRET=


# ============================================================================
# 12. 后台超管(仅本地开发 / staging seed,生产用 admin UI 创建)
# ============================================================================

# 首次 seed 时创建的 super-admin 邮箱
# [NEEDS-INPUT,P2 阶段] 用户提供
SUPERADMIN_EMAIL=

# 首次密码(首次登录强制改)
# [NEEDS-INPUT,P2 阶段] 用户提供 / 用密码管理器生成
SUPERADMIN_PASSWORD=


###############################################################################
# 校验机制(P0 实施)
#
# src/lib/env.ts 用 Zod schema 校验本文件:
#
#   import { z } from 'zod'
#   const envSchema = z.object({
#     NEXT_PUBLIC_SITE_URL: z.string().url(),
#     NEXT_PUBLIC_DEFAULT_LOCALE: z.enum(['zh','en','ru']),
#     PAYLOAD_SECRET: z.string().min(32),
#     DATABASE_URI: z.string().startsWith('postgresql://'),
#     ...
#   })
#   export const env = envSchema.parse(process.env)
#
# 启动时若必需变量缺失,直接 throw 退出,避免运行期错误
#
# 代码内**禁止**直接 process.env.XXX,统一从 src/lib/env.ts 导入
###############################################################################
