{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "node_modules/.cache/yourfield-scripts",
    "rootDir": "scripts",
    "sourceMap": false,
    "tsBuildInfoFile": "node_modules/.cache/yourfield-scripts/tsconfig.scripts.tsbuildinfo"
  },
  "include": ["scripts/check-i18n-coverage.ts", "scripts/snapshot-mobile.ts"]
}
